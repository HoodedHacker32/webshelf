# Caddy gets a free HTTPS certificate for SEARX_HOST, lets the Webshelf site
# (and a local copy for testing) read the results, and passes share-price
# requests to market.py (container/market.py), which fetches them from Yahoo
# Finance and keeps each answer for a while, shared between visitors.

{$SEARX_HOST} {
	encode zstd gzip

	# Only Webshelf's own pages may read responses from a browser.
	@webshelf header_regexp Origin {$ALLOWED_ORIGINS}
	header @webshelf {
		Access-Control-Allow-Origin {http.request.header.Origin}
		Access-Control-Allow-Methods "GET, OPTIONS"
		Vary Origin
	}
	header {
		-Server
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}

	# Browsers check before cross-site requests; answer here, not in SearXNG.
	# (handle blocks run in the order written and only one of them runs.)
	@preflight method OPTIONS
	handle @preflight {
		respond 204
	}

	# Share prices: only the two calls the market card makes.
	@market path_regexp ^/market/(search|chart)$
	handle @market {
		uri strip_prefix /market
		reverse_proxy market:8090
	}
	handle /market/* {
		respond 404
	}

	handle {
		reverse_proxy searxng:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}
