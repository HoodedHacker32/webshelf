{
	auto_https off
	admin off
}

# The host provides HTTPS; Caddy adds browser access for Webshelf only and
# sends share-price requests to market.py, which keeps answers for a while,
# shares them between visitors and adds the Twelve Data key (host environment
# variable TWELVE_DATA_KEY; optional FINNHUB_KEY).
:7860 {
	encode zstd gzip
	@webshelf header_regexp Origin {$ALLOWED_ORIGINS:^(https://hoodedhacker32\.github\.io|http://localhost:8417)$}
	header @webshelf {
		Access-Control-Allow-Origin {http.request.header.Origin}
		Access-Control-Allow-Methods "GET, OPTIONS"
		Vary Origin
	}
	@preflight method OPTIONS
	handle @preflight {
		respond 204
	}
	@market path_regexp ^/market/(quote|time_series)$
	handle @market {
		uri strip_prefix /market
		reverse_proxy 127.0.0.1:8090
	}
	handle /market/* {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
